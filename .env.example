# Copie para .env e preencha somente o canal que for usar. Nunca versionar o .env.

# --- WhatsApp Cloud API (Meta) ---
# Meta for Developers > seu app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# Token temporario (24h) para o primeiro teste; depois troque pelo token
# permanente de um System User em Business Settings > Users > System users.
WHATSAPP_TOKEN=
# Opcional: "WhatsApp Business Account ID" da mesma tela. Serve para o
# diagnostico conferir se o template ja foi aprovado.
WHATSAPP_WABA_ID=

# --- Bot de cadastro dos pais (npm run bot) ---
# Senha que voces inventam; a mesma vai no campo "Verify token" do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=
# Meta for Developers > seu app > App settings > Basic > App Secret.
# O bot recusa qualquer POST que nao venha assinado com ele.
WHATSAPP_APP_SECRET=

# --- Outros canais ---
SMTP_USER=
SMTP_PASS=
WEBHOOK_TOKEN=
